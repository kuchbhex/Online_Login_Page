-- SPEED (GLICH) – ON/OFF theek se
function glich()
    toggle.glich = not toggle.glich
    gg.setRanges(gg.REGION_ANONYMOUS)
    if toggle.glich then
        gg.searchNumber("h 00 01 00 00 00 02 2B 07 3D", gg.TYPE_BYTE)
        local r = gg.getResults(10000)
        if #r > 0 then
            gg.editAll("h 00 01 00 00 00 02 2B 60 3D", gg.TYPE_BYTE)
        end
        gg.clearResults()
        gg.toast("💢speed 𝕺𝖓💢")
    else
        gg.searchNumber("h 00 01 00 00 00 02 2B 60 3D", gg.TYPE_BYTE)
        local r = gg.getResults(10000)
        if #r > 0 then
            gg.editAll("h 00 01 00 00 00 02 2B 07 3D", gg.TYPE_BYTE)
        end
        gg.clearResults()
        gg.toast("💢speed 𝕺𝖋𝖋💢")
    end
end


local info = gg.getTargetInfo()
if info == nil then
    gg.alert("Koi game select nahi hai! Pehle GameGuardian se game select karo.")
    os.exit()
end

local Game  = info.label or "Unknown"
local Ver   = info.versionName or "Unknown"
local Pak   = info.packageName or "Unknown"
local Bit   = info.x64 and "x64" or "x32"

function hello()
    gg.alert([[
    ⧉⧉⧉⧉⧉⧉⧉⧉⧉⧉⧉⧉⧉⧉⧉⧉⧉
                                        
     ＧＡＭＥ   ＩＮＦＯ               
─────────────────────        
                                        
▶ 🎮 𝐆𝐀𝐌𝐄 𝐍𝐀𝐌𝐄      :  ]]..Game..[[
                                       
                                       
▶ 📦 𝐏𝐀𝐂𝐊𝐀𝐆𝐄  :  ]]..Pak..[[         
       

▶ 🧬 𝐕𝐄𝐑𝐒𝐈ϴ𝐍  :  ]]..Ver..[[


▶ 💽 𝐀𝐑𝐂𝐇    :  ]]..Bit..[[


⧉⧉⧉⧉⧉⧉⧉⧉⧉⧉⧉⧉⧉⧉⧉⧉⧉
]],  "🔥 𝐃𝐀𝐑𝐊 𝐅𝐅 𝐖𝐎𝐑𝐋𝐃  ⚡")
end

hello()
gg.toast("Tap on icon to open menu")

--⬛⃢ Toggle States
local toggle = {
  headshot = false,
  antenna = false,
  glich   = false,
  location= false,
  sniper  = false,
  camera  = false
}

-- 1‑time features ka visibility control
local used = {
  headshot = false,
  antenna  = false,
  glich    = false,
  location = false,
  sniper   = false
  -- camera aur glich (speed) hamesha menu me rahenge
}

function DARK()
    gg.setVisible(false)

    local items = {}
    local mapIndex = {}

    local idx = 1

    if not used.headshot then
        items[idx] = (toggle.headshot and "  ⃢⬜" or "⬛⃢    ") .. " 𝐕𝐒𝐊 𝐀𝐈𝐌𝐁𝐎𝐓 ˡᵒᵍⁱⁿ🎯"
        mapIndex[idx] = "headshot"
        idx = idx + 1
    end

    if not used.antenna then
        items[idx] = (toggle.antenna and "  ⃢⬜" or "⬛⃢    ") .. " 𝐕𝐒𝐊 𝐅𝐀𝐒𝐓 𝐒𝐖𝐈𝐓𝐂𝐇 ˡᵒᵍⁱⁿ🔫"
        mapIndex[idx] = "antenna"
        idx = idx + 1
    end

    -- GLITCH / SPEED: hamesha visible
    items[idx] = (toggle.glich and "  ⃢⬜" or "⬛⃢    ") .. " 𝐒𝐏𝐄𝐄𝐃 𝐇𝐀𝐂𝐊 ᴵᴺ ᴳᴬᴹᴱ⚡"
    mapIndex[idx] = "glich"
    idx = idx + 1

    if not used.location then
        items[idx] = (toggle.location and "  ⃢⬜" or "⬛⃢    ") .. "𝐒𝐍𝐈𝐏𝐄𝐑 𝐀𝐈𝐌𝐁𝐎𝐓 ˡᵒᵍⁱⁿ🏹"
        mapIndex[idx] = "location"
        idx = idx + 1
    end

    if not used.sniper then
        items[idx] = (toggle.sniper and "  ⃢⬜" or "⬛⃢    ") .. " 𝐒𝐍𝐈𝐏𝐄𝐑 𝐅𝐀𝐒𝐓 𝐒𝐖𝐈𝐓𝐂𝐇 ˡᵒᵍⁱⁿ🚀"
        mapIndex[idx] = "sniper"
        idx = idx + 1
    end

    -- CAMERA: hamesha visible
    items[idx] = (toggle.camera and "  ⃢⬜" or "⬛⃢    ") .. " 𝐂𝐀𝐌𝐄𝐑𝐀 𝐇𝐀𝐂𝐊 ᴵᴺ ᴳᴬᴹᴱ📷"
    mapIndex[idx] = "camera"
    idx = idx + 1

    items[idx] = "💢𝕿𝖝𝖎𝖙 𝕾𝖈𝖗𝖎𝖕𝖙"
    local exitIndex = idx

    local menu = gg.choice(
        items,
        nil,
        "      ⧉⧉:👑 𝗗𝗔𝗥𝗞 𝗙𝗙 𝗚𝗛𝗢𝗦𝗧:⧉⧉"
    )

    if menu == nil then
        gg.toast("⚠️ No option selected")
        return
    end

    if menu == exitIndex then
        gg.toast("𝐃ϴ𝐍'𝐓 𝐅ϴ𝐑𝐆𝐄𝐓 𝐘ϴ𝐔𝐑 𝐏𝐋𝐀𝐂𝐄 𝐅ϴϴ𝐋")
        os.exit()
    end

    local key = mapIndex[menu]
    if key == "headshot" then
        headshot()
        used.headshot = true  -- 1 bar use, fir hide
    elseif key == "antenna" then
        antenna()
        used.antenna = true
    elseif key == "glich" then
        glich()
        -- speed/glich hide nahi hoga
    elseif key == "location" then
        location()
        used.location = true
    elseif key == "sniper" then
        sniper()
        used.sniper = true
    elseif key == "camera" then
        camera()
        -- camera bhi hamesha rahega
    end
end

-- HEADSHOT
function headshot()
    toggle.headshot = not toggle.headshot
    if toggle.headshot then
        gg.setRanges(gg.REGION_ANONYMOUS)
        gg.searchNumber("h 01 00 00 00 00 00 00 00 00 00 00 00 C5 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 01", gg.TYPE_BYTE)
        local r = gg.getResults(1000)
        if #r > 0 then
            gg.editAll("h 01 00 00 00 00 00 00 00 00 00 00 00 C5 00 00 00 00 00 00 00 00 00 00 00 01 00 00 00 00", gg.TYPE_BYTE)
        end
        gg.clearResults()
        gg.toast("💢 vsk ΛIMBӨƬ σи💢")
    else
        gg.toast("❌ vsk ΛIMBӨƬ σff")
    end
end

